# =============================================================================
# esLink Interface Server (EIS)
# Copy this file to .env and fill in the values.
# =============================================================================

# --- HTTP server ------------------------------------------------------------
# EIS listens here for the trigger ping from eslink.online PHP.
# Bound to 127.0.0.1 because nothing outside this VPS should be able to
# trigger a queue drain.
PORT=3222
HOST=127.0.0.1

# --- eslink.online application identity -------------------------------------
# EIS is a server-side component and is NOT bound to a single property.
APP_ID=3sJX0n8g6__a
APP_SECRET=

# --- eslink.online API ------------------------------------------------------
# Used for outbound calls back into PHP, currently only the email helper.
ESLINK_API_URL=https://eslink.online/interface-client-api.php
ESLINK_API_TIMEOUT=30000

# --- Database ---------------------------------------------------------------
# Note the database name contains a dot, so quote it if you use it on a
# command line. No quoting is needed here.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sohailshaikhz_eslink.online
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=5

# --- Queue processing -------------------------------------------------------
# Rows are normally drained the moment PHP pings us. This sweep is the safety
# net for a ping that was lost, and for retries that have become due.
QUEUE_SWEEP_INTERVAL=60000

# How many rows one drain pass claims. Keep this modest - each delivery to the
# NCS endpoint triggers a RADIUS restart on that box.
QUEUE_BATCH_SIZE=20

# Pause between two deliveries to the SAME endpoint, in milliseconds. Prevents
# a backlog from restarting RADIUS twenty times in two seconds.
QUEUE_ENDPOINT_PACING=1500

# Wait this long before retrying a failed delivery.
QUEUE_RETRY_DELAY=300000

# Give up on a row this long after it was created. An expired row is never
# deleted, so support can still see what was missed.
QUEUE_MAX_AGE=86400000

# --- Delivery ---------------------------------------------------------------
DELIVERY_TIMEOUT=20000

# --- Notifications ----------------------------------------------------------
# EIS does not send SMTP itself - it asks eslink.online to do it.
NOTIFY_ENABLED=true
NOTIFY_REPEAT_INTERVAL=900000

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=production
